{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Deploy separado do `cf-os deploy`: `pnpm exec wrangler deploy` nesta pasta (README).
	"name": "ness-m365-mcp",
	"main": "src/index.ts",
	"account_id": "0a6c490dd5fe9051422c15c9e133138e",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "m365.ness.com.br",
			"custom_domain": true
		}
	],
	"vars": {
		"REDIRECT_PERMITIDO": "https://work.ness.com.br/gatekeeper/mcp/",
		// Object ID do grupo do PMO no Entra ("ness. Heads"). Vazio: ninguém cria nem atribui tarefas.
		"PMO_GROUP_ID": "fc9ca1d7-37b3-4877-8544-9b7e536da227"
	},
	// Sem id: o Wrangler cria os dois no primeiro deploy e grava o id aqui.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "093a41f48b5f45e98b89702a7b5e389d"
		}
	],
	"d1_databases": [
		{
			"binding": "AUDITORIA",
			"database_name": "ness-m365-auditoria",
			"migrations_dir": "migrations",
			"database_id": "c73f7e77-b84d-446a-8930-c9d956d007ac"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	}
	// Secrets: ENTRA_TENANT_ID, ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET (wrangler secret put).
}
+  return "<p:embeddedFontLst>" + [...porFamilia].map(([typeface, refs]) =>
+    `<p:embeddedFont><p:font typeface="${typeface}" pitchFamily="${typeface === "JetBrains Mono" ? 49 : 2}" charset="0"/>${refs}</p:embeddedFont>`).join("") + "</p:embeddedFontLst>";
